{
  "id": null,
  "uid": "czts-overview",
  "title": "Cognitive Zero Trust Server",
  "tags": [
    "czts",
    "security"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 2,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Restricted transitions (24h)",
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "loki",
        "uid": "lokiczts"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({job=\"czts\",event_type=\"state_change\",state=\"restricted\"}[24h]))",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      },
      "description": "Historical event count for the stated time window; this does not indicate currently active sessions."
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Discarded transitions (24h)",
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "datasource": {
        "type": "loki",
        "uid": "lokiczts"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({job=\"czts\",event_type=\"state_change\",state=\"discarded\"}[24h]))",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 3
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      },
      "description": "Historical event count for the stated time window; this does not indicate currently active sessions."
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Step-up challenges (24h)",
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "datasource": {
        "type": "loki",
        "uid": "lokiczts"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({job=\"czts\",event_type=\"step_up\"}[24h]))",
          "queryType": "instant"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      },
      "description": "Historical event count for the stated time window; this does not indicate currently active sessions."
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Average trust belief across sessions",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "datasource": {
        "type": "loki",
        "uid": "lokiczts"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "avg(avg_over_time({job=\"czts\",event_type=\"command\"} | json | unwrap belief [30s]))",
          "queryType": "range",
          "legendFormat": "Mean belief"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1
        }
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "drawStyle": "line",
        "lineWidth": 2,
        "showPoints": "always",
        "pointSize": 6
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "State changes over time",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "datasource": {
        "type": "loki",
        "uid": "lokiczts"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (state) (count_over_time({job=\"czts\",event_type=\"state_change\"}[1m]))",
          "queryType": "range",
          "legendFormat": "{{state}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 6,
      "type": "logs",
      "title": "Recent CZTS event stream",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 27
      },
      "datasource": {
        "type": "loki",
        "uid": "lokiczts"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{job=\"czts\"}",
          "queryType": "range",
          "maxLines": 100
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Step-up outcomes by result",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "datasource": {
        "type": "loki",
        "uid": "lokiczts"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (count_over_time({job=\"czts\",event_type=\"step_up\"} | json | label_format outcome=\"{{.outcome}}\" [1h]))",
          "queryType": "range",
          "legendFormat": "{{outcome}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Top rules fired (24h)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "datasource": {
        "type": "loki",
        "uid": "lokiczts"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, sum by (rule) (count_over_time({job=\"czts\",event_type=\"command\"} | json | rule_names!=\"\" | label_format rule=\"{{.rule_names}}\" [24h])))",
          "queryType": "range",
          "legendFormat": "{{rule}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "description": "Historical event count for the stated time window; this does not indicate currently active sessions."
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Learning updates (24h)",
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 0,
        "y": 22
      },
      "datasource": {
        "type": "loki",
        "uid": "lokiczts"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({job=\"czts\",event_type=\"learning_update\"}[24h]))",
          "queryType": "instant"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      },
      "description": "Count of profile updates recorded in the previous 24 hours; these are historical events."
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Session starts minus ends (7d)",
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 8,
        "y": 22
      },
      "datasource": {
        "type": "loki",
        "uid": "lokiczts"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({job=\"czts\",event_type=\"session_start\"}[7d])) - sum(count_over_time({job=\"czts\",event_type=\"session_end\"}[7d]))",
          "queryType": "instant",
          "legendFormat": "Updates"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      },
      "description": "Seven-day difference between session start and end events. A nonzero value can include interrupted or missing logs; it is not a live connection count."
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Learning updates over time",
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 16,
        "y": 22
      },
      "datasource": {
        "type": "loki",
        "uid": "lokiczts"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({job=\"czts\",event_type=\"learning_update\"}[1h]))",
          "queryType": "range",
          "legendFormat": "Updates"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    }
  ],
